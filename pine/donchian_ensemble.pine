//@version=6
// Ансамбль пробоев Дончиана с размером позиции по волатильности (реплика Zarattini, Pagani, Barbon 2025, SSRN 5209907)
// Тот же алгоритм, что signal_lab/h2.py (версия v1), но с потолком веса 100 % (без плеча).
// Результаты проверки (docs/research/experiments/H2-donchian-ensemble.md), после 10 б.п.:
//   2018–03.2025: Sharpe ≈ 1.3 BTC / 1.1 ETH, просадка 15–20 %;  04.2025–09.2026: Sharpe 0.06 BTC / 0.62 ETH.
// Это инструмент анализа тренда и риска, а НЕ гарантия дохода и НЕ финансовый совет.
// Использовать на ДНЕВНОМ графике (окна заданы в днях = барах).
strategy("Donchian Ensemble (Zarattini) — vol-targeted", overlay = true,
     initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.1,
     default_qty_type = strategy.fixed, process_orders_on_close = false, pyramiding = 0, margin_long = 100)

targetVol = input.float(0.25, "Целевая годовая волатильность", minval = 0.05, maxval = 1.0, step = 0.05)
volLen    = input.int(90, "Окно волатильности, дней", minval = 20)
maxW      = input.float(1.0, "Максимальный вес (1 = 100 % капитала, без плеча)", minval = 0.1, maxval = 1.0)
band      = input.float(0.20, "Порог ребаланса по волатильности", minval = 0.0, maxval = 0.5)
showStops = input.bool(true, "Показывать стоп окна 20 дней")

if timeframe.period != "D"
    runtime.error("Стратегия рассчитана на дневной график (1D)")

// Одна модель окна n: вход, когда закрытие = максимум закрытий за n дней (включая сегодня);
// выход, когда закрытие ≤ стопа; стоп = max(прежний стоп, середина канала), при входе — середина канала.
donchian(int n) =>
    var int   pos  = 0
    var float stop = na
    hi  = ta.highest(close, n)
    lo  = ta.lowest(close, n)
    mid = (hi + lo) / 2
    bool exited = false
    if pos == 1
        if close <= stop
            pos := 0
            exited := true
        else
            stop := math.max(stop, mid)
    if pos == 0 and not exited and not na(hi) and close >= hi
        pos := 1
        stop := mid
    [na(hi) ? 0 : pos, stop]

[p5, s5]     = donchian(5)
[p10, s10]   = donchian(10)
[p20, s20]   = donchian(20)
[p30, s30]   = donchian(30)
[p60, s60]   = donchian(60)
[p90, s90]   = donchian(90)
[p150, s150] = donchian(150)
[p250, s250] = donchian(250)
[p360, s360] = donchian(360)

inTrend = (p5 + p10 + p20 + p30 + p60 + p90 + p150 + p250 + p360) / 9.0     // доля окон «в тренде», 0…1
ret     = close / close[1] - 1
sigma   = ta.stdev(ret, volLen) * math.sqrt(365)
scale   = na(sigma) or sigma == 0 ? 0.0 : math.min(maxW, targetVol / sigma)
target  = bar_index >= 360 ? inTrend * scale : 0.0

// Сигнальные изменения (вход/выход любого окна) исполняются сразу; изменения из-за волатильности — только за порогом.
signalChanged = inTrend != nz(inTrend[1])
var float curW = 0.0
if signalChanged or (curW == 0 and target > 0) or (target == 0 and curW > 0) or (curW > 0 and math.abs(target - curW) > band * curW)
    curW := target
    qty = curW * strategy.equity / close
    if curW <= 0
        strategy.close_all(comment = "flat")
    else
        delta = qty - strategy.position_size
        if delta > 0
            strategy.order("rebal+", strategy.long, qty = delta)
        else if delta < 0
            strategy.order("rebal-", strategy.short, qty = -delta)

plot(showStops and p20 == 1 ? s20 : na, "Стоп окна 20 д", color.orange, 1, plot.style_linebr)
bgcolor(inTrend >= 0.67 ? color.new(color.green, 88) : inTrend > 0 ? color.new(color.green, 95) : na)
plotchar(curW, "Вес позиции", "", location.top, display = display.data_window)
plotchar(inTrend, "Доля окон в тренде", "", location.top, display = display.data_window)
plotchar(sigma, "Волатильность 90д (годовая)", "", location.top, display = display.data_window)
