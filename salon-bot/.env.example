# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111
# Чат для уведомлений о записях/отменах/вопросах (можно группу, ID начинается с -100).
# Если пусто — уведомления уходят первому админу из ADMIN_IDS
ADMIN_CHAT_ID=

# --- Источник записей ---
# dikidi — работа с журналом DIKIDI Business; local — тестовый режим без DIKIDI
BACKEND=dikidi

# --- DIKIDI Business (аккаунт владельца/администратора салона) ---
DIKIDI_PHONE=+79000000000
DIKIDI_PASSWORD=your_password
# ID компании: число из ссылки вида https://dikidi.ru/1234567
DIKIDI_COMPANY=1234567
# Ссылка на онлайн-запись DIKIDI (показывается в «Контактах»)
DIKIDI_BOOKING_URL=https://dikidi.ru/1234567

# --- Салон ---
SALON_NAME=Lash Studio
SALON_ADDRESS=г. Москва, ул. Примерная, 1
SALON_PHONE=+7 900 000-00-00
TIMEZONE=Europe/Moscow

# --- Параметры записи ---
BOOKING_DAYS_AHEAD=14
# Не предлагать время раньше, чем через N минут от текущего
MIN_LEAD_MINUTES=60
SLOT_STEP_MINUTES=30
# Рабочие часы (используются только в режиме local; в dikidi — графики из DIKIDI)
WORK_START=10:00
WORK_END=20:00
# Как часто сверять записи с DIKIDI (отмены/переносы администратором)
SYNC_INTERVAL_SECONDS=300
