# Copy this file to `.env` and fill in your real values. `.env` is gitignored.

# Required — used for wave classification prompts and prediction rescoring
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — powers the Twitter/X sentiment refresh via Apify actors
APIFY_API_TOKEN=your-apify-token-here

# Optional — gates the tier-1/tier-2 Claude rescoring pass (1 = on)
CLAUDE_RESCORE_TIER12=1
