# Скопируйте в .env и заполните. .env не коммитится.

# Токен от @BotFather для @regime_ai_bot
BOT_TOKEN=123456:ABC-your-token

# Ваш Telegram ID (узнать: @userinfobot). Через запятую, если админов несколько
ADMIN_IDS=123456789

# Общий секрет для подписи сигналов от локальной модели (сгенерировать: python -c "import secrets;print(secrets.token_hex(32))")
SIGNAL_API_SECRET=

# polling — проще всего (подходит и для сервера); webhook — нужен HTTPS-домен
MODE=polling
WEBHOOK_BASE=
WEBHOOK_SECRET=

# Порт HTTP API для сигналов (и вебхука в режиме webhook)
API_HOST=0.0.0.0
API_PORT=8081

# Необязательно: приватный канал с сигналами (бот должен быть админом с правом приглашать и банить)
CHANNEL_ID=

SUPPORT=@regime_support
TERMS_URL=
REFERRAL_BONUS_DAYS=7
DB_PATH=data/regime_bot.sqlite3

# Тарифы (цены в Telegram Stars). По умолчанию: 1 мес 990⭐ (автопродление), 3 мес 2490⭐, 12 мес 7990⭐
# PLANS_JSON=[{"code":"m1","title":"1 месяц","days":30,"stars":990,"recurring":true},{"code":"m3","title":"3 месяца","days":90,"stars":2490,"badge":"−16%"}]
